{
  "expo": {
    "name": "Heart Hugs",
    "slug": "hearthugs",
    "version": "1.2.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "backgroundColor": "#FFF9F0",
    "userInterfaceStyle": "light",
    "ios": {
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      },
      "supportsTablet": false,
      "bundleIdentifier": "com.jgonzales562.hearthugs"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand-mark.png",
        "backgroundColor": "#FFF9F0"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "allowBackup": false,
      "package": "com.jgonzales562.hearthugs",
      "versionCode": 6,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF9F0",
          "image": "./assets/brand-mark.png",
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a309561e-e567-4788-b032-7576b826615b"
      }
    },
    "owner": "jgonzales562s-team"
  }
}
